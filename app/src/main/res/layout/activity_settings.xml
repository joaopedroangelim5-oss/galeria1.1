<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gk_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarSettings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gk_surface"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/menu_settings"
            app:titleTextColor="@color/gk_white" />

        <LinearLayout
            android:id="@+id/rowBackground"
            style="@style/SettingsRow">

            <ImageView
                style="@style/SettingsRowIcon"
                android:src="@drawable/ic_wallpaper" />

            <LinearLayout style="@style/SettingsRowTextContainer">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/menu_background" />

                <TextView
                    style="@style/SettingsRowSubtitle"
                    android:text="@string/settings_background_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowPin"
            style="@style/SettingsRow">

            <ImageView
                style="@style/SettingsRowIcon"
                android:src="@drawable/ic_lock" />

            <LinearLayout style="@style/SettingsRowTextContainer">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/menu_pin" />

                <TextView
                    style="@style/SettingsRowSubtitle"
                    android:text="@string/settings_pin_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/SettingsDivider" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/settings_about" />

        <TextView
            android:id="@+id/tvVersion"
            style="@style/SettingsRowSubtitle"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/app_name" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/settings_features_title" />

        <TextView
            style="@style/SettingsRowSubtitle"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/settings_features_body" />

        <View style="@style/SettingsDivider" />

        <LinearLayout
            android:id="@+id/rowSecure"
            style="@style/SettingsRow">

            <ImageView
                style="@style/SettingsRowIcon"
                android:src="@drawable/ic_shield" />

            <LinearLayout style="@style/SettingsRowTextContainer">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/secure_mode" />

                <TextView
                    style="@style/SettingsRowSubtitle"
                    android:text="@string/settings_secure_subtitle" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
