<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gk_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_enter"
        android:textColor="@color/gk_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pin_wrong"
        android:textColor="@color/gk_pink"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <View android:id="@+id/dot1" style="@style/PinDot" />
        <View android:id="@+id/dot2" style="@style/PinDot" />
        <View android:id="@+id/dot3" style="@style/PinDot" />
        <View android:id="@+id/dot4" style="@style/PinDot" />
    </LinearLayout>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/btn1" style="@style/PinKey" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/PinKey" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/PinKey" android:text="3" />
        <Button android:id="@+id/btn4" style="@style/PinKey" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/PinKey" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/PinKey" android:text="6" />
        <Button android:id="@+id/btn7" style="@style/PinKey" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/PinKey" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/PinKey" android:text="9" />
        <View android:layout_width="72dp" android:layout_height="72dp" />
        <Button android:id="@+id/btn0" style="@style/PinKey" android:text="0" />
        <Button android:id="@+id/btnDel" style="@style/PinKey" android:text="⌫" />
    </GridLayout>
</LinearLayout>
